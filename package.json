{
    "type": "module",
    "devDependencies": {
        "markdown-it-mathjax3": "^4.3.2",
        "simple-git-hooks": "^2.13.1",
        "vitepress": "^1.5.0"
    },
    "scripts": {
        "prepare": "simple-git-hooks",
        "hooks:install": "simple-git-hooks",
        "generate:sidebar": "node docs/.vitepress/theme/script/genSidebar.js",
        "generate:skills_cloud": "node docs/.vitepress/theme/script/genSkillsCloud.js",
        "generate:at_pages": "node docs/.vitepress/theme/script/genAtPages.js",
        "generate:RP_RSS": "npm run generate:sidebar && node docs/.vitepress/theme/script/genRecentPosts.js && node docs/.vitepress/theme/script/genSkillsCloud.js && node docs/.vitepress/theme/script/genAtPages.js && node docs/.vitepress/theme/script/generate-rss.mjs",
        "docs:dev": "npm run generate:RP_RSS && vitepress dev docs",
        "docs:build": "npm run generate:RP_RSS && vitepress build docs",
        "docs:preview": "npm run generate:RP_RSS && vitepress preview docs"
    },
    "simple-git-hooks": {
        "pre-commit": "sh .githooks/pre-commit"
    },
    "volta": {
        "node": "23.6.0"
    },
    "dependencies": {
        "@mermaid-js/mermaid-cli": "^11.4.2",
        "@vueuse/core": "^13.2.0",
        "axios": "^1.9.0",
        "cheerio": "^1.0.0",
        "chinese-lunar": "^0.1.4",
        "esbuild": "^0.25.4",
        "gray-matter": "^4.0.3",
        "markdown-it": "^14.1.0",
        "markdown-it-task-lists": "^2.1.1",
        "mathjax": "^3.2.2",
        "mermaid": "^11.4.1",
        "pixi-live2d-display": "^0.4.0",
        "pixi.js": "^8.9.2",
        "puppeteer": "^23.11.1",
        "rss": "^1.2.2",
        "vue": "^3.5.13",
        "vue-router": "^4.0.13"
    }
}
